# Direct RUNTIME dependencies.
#
# This file lists only what the application imports. Transitive
# dependencies and exact versions live in the compiled lock,
# requirements.txt, which is generated -- never edit that file by hand.
#
# Regenerate with:
#   uv pip compile requirements.in -o requirements.txt \
#       --universal --python-version 3.12 --generate-hashes
#
# Recompiling keeps the versions already pinned in requirements.txt;
# pass --upgrade (or --upgrade-package NAME) to move them deliberately.

fastapi

# Floor, not a preference. app/http_limits.py imports
# starlette.middleware.body_limit, which arrived in starlette 1.6.0.
# FastAPI's own floor is starlette>=0.46.0 and so does not guarantee it.
starlette>=1.6.0

uvicorn[standard]

asyncpg

# Used directly (app/config.py imports SecretStr), not merely inherited
# from fastapi, so it is named here rather than left to the resolver.
pydantic
pydantic-settings

strawberry-graphql[fastapi]==0.326.0

structlog

# Argon2id password hashing, used by app/services/passwords.py.
#
# The reference implementation of the algorithm (libargon2) with a thin
# Python binding, rather than a pure-Python one: the cost parameters are
# the entire security argument for a password hash, and a pure-Python
# implementation cannot make them expensive for an attacker without making
# them ruinous for the server.
argon2-cffi

# RSA signing for the GitHub App's authentication JWT.
#
# A GitHub App proves who it is by presenting a JWT it signed with its
# private key, exchanges that for a short-lived installation token, and
# uses the token to read the installation's repositories. The signature
# is RS256, which no part of the standard library can produce -- hashlib
# and hmac cover symmetric algorithms only, and the webhook's HMAC-SHA256
# is why nothing here needed a crypto library until now.
#
# The alternative was to abandon installation tokens and use the
# user-to-server token from the OAuth code instead. That is a worse
# design, not a cheaper one: it ties what Vector can see to one person's
# account, breaks when they leave, and means storing a user's bearer
# credential -- which app/rest/github.py deliberately refuses to do.
cryptography

# The HTTP client for those GitHub API calls.
#
# Already the dev lock's test client (starlette's TestClient is built on
# it), so this promotes a dependency the project has rather than adding a
# new one. Async, because every call sits on the request path of an
# already-async application.
httpx
