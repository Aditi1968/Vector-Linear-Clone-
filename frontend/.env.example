# Copy to frontend/.env.local to override. Every value here is optional:
# the defaults in src/lib/config/env.ts are what local development uses, so
# a developer who never creates this file still gets a working app.
#
# NOTE: nothing in this file is a secret. Vite inlines every `VITE_`-prefixed
# variable into the JavaScript bundle it ships to the browser, so a value put
# here is published to anyone who loads the page. The GraphQL endpoint is
# public configuration -- the browser has to know the URL in order to call it
# -- and that is the only kind of value that belongs in a `VITE_` variable.
# Database URLs, API keys and tokens must never appear here; they belong to
# the backend's own .env, which this application never reads.

# Where the browser sends GraphQL operations.
#
# Leave this as a same-origin *path*. In development Vite proxies `/graphql`
# to the backend (see vite.config.ts) precisely so that this can stay a path:
# the backend serves no CORS headers, so pointing this at an absolute
# cross-origin URL such as http://127.0.0.1:8000/graphql makes the browser
# discard every response. src/lib/config/env.ts warns about that at startup.
VITE_GRAPHQL_URL=/graphql
