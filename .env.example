# Copy to .env and fill in. Both variables are required: neither has a
# default, so a missing one fails when the application is created rather
# than surfacing later as odd behaviour.

# PostgreSQL DSN. The value below is a placeholder, not a reachable
# database -- never commit a real one.
DATABASE_URL=postgresql://user:password@host:5432/vector

# development | test | production
#
# Gates the protections that only production needs: production serves no
# GraphiQL and answers no introspection. Required rather than defaulted,
# because the safe value is the one nobody forgets to ask for.
ENVIRONMENT=development
